{
  "version": 1,
  "default_model": "gpt-6-astra",
  "read_only_model": "gpt-5.6-luna",
  "allowed_worker_models": [
    "gpt-5.6-luna",
    "gpt-5.6-terra",
    "gpt-5.6-sol",
    "gpt-6-astra"
  ],
  "restricted_worker_models": {
    "gpt-6-astra": {
      "required_env": "CODEX_ALLOW_ASTRA_WORKER",
      "required_value": "1"
    },
    "gpt-5.6-sol": {
      "required_env": "CODEX_ALLOW_SOL_WORKER",
      "required_value": "1"
    }
  },
  "require_explicit_agent": true,
  "require_explicit_model": true
}
