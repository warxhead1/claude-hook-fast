# claude-steward systemd USER unit
# Install with:
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-steward
#
# Starts in OBSERVER mode (no actuation) by default: it only writes
# ~/.claude/steward/budget.json. Continuous ticking is the default; --interval
# sets the period. Phases are opened via flags on ExecStart:
#   --enable-notify        Phase 0/1: advisory notifications on pressure rise
#   --enable-gate          Phase 1: publish the fan-out gate for the rules engine
#   --enable-compact       Phase 2: actuation (send-keys/socket /compact)
#   --enable-fanout-block  Phase 3: block new fan-out in CRITICAL state
#
# To pause all actuation, create ~/.claude/steward/pause (honored on the next
# tick, no restart needed):
#   touch ~/.claude/steward/pause
#
# Example ExecStart for Phase 2 (actuation + gating):
#   ExecStart=%h/.local/bin/claude-steward --interval 30s --enable-compact --enable-gate
#
# The pause file is checked before every action and honored immediately.

[Unit]
Description=Claude session budget steward — rate-limit-aware session compaction
Documentation=file://%h/.config/systemd/user/claude-steward.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/claude-steward --interval 30s
Restart=on-failure
RestartSec=10

# Low priority: steward is a background observer, must never contend with real work
Nice=15
IOSchedulingClass=idle

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=claude-steward

[Install]
WantedBy=default.target
